# Groq API Key (Required)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here

# WhatsApp Support URL (Required)
# Format: https://wa.me/1234567890?text=Hello%20I%20need%20help
VITE_WHATSAPP_SUPPORT_URL=https://wa.me/YOUR_PHONE_NUMBER

# Refresh Secret (Optional - for protecting /api/refresh endpoint)
# Generate a random string for production
REFRESH_SECRET=your_random_secret_here
